{
  "name": "nodal",
  "version": "0.1.1",
  "private": true,
  "description": "Open-source agent that checks a product against India's intermediary due diligence rules: 11 Claude Code skills, a gazette-checked rule catalog, JSON Schemas and write-guard hooks",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prathikcannotcode/nodal.git"
  },
  "homepage": "https://github.com/prathikcannotcode/nodal#readme",
  "bugs": "https://github.com/prathikcannotcode/nodal/issues",
  "keywords": [
    "it-rules",
    "intermediary",
    "grievance-officer",
    "safe-harbour",
    "compliance",
    "claude-code",
    "india",
    "agent"
  ],
  "scripts": {
    "validate": "node .claude/scripts/validate.mjs",
    "audit": "node .claude/scripts/validate.mjs --strict",
    "test": "node --test .claude/scripts/tests/*.test.mjs",
    "export:sarif": "node .claude/scripts/export-sarif.mjs"
  },
  "engines": {
    "node": ">=22"
  }
