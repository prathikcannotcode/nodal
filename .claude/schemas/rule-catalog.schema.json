{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule Catalog",
  "description": "catalog/rules.json: every obligation nodal checks. A finding's clause must be one of these clauses or a sub-clause of one.",
  "type": "object",
  "required": ["last_verified", "instruments", "rules"],
  "properties": {
    "last_verified": { "type": "string", "format": "date" },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "title", "notifications"],
        "properties": {
          "code": { "type": "string", "enum": ["IT-RULES", "ECOM-RULES"] },
          "title": { "type": "string", "minLength": 1 },
          "notifications": {
            "type": "array",
            "description": "The principal notification and each amendment, with whether its gazette text was read when the catalog was built",
            "items": {
              "type": "object",
              "required": ["number", "date", "read"],
              "properties": {
                "number": { "type": "string", "minLength": 1 },
                "date": { "type": "string", "format": "date" },
                "read": { "type": "boolean" },
                "source_url": { "type": "string", "pattern": "^https://" },
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "instrument", "clause", "applies_to", "obligation", "deadline", "evidence_hints", "default_severity", "verified", "source_url"],
        "properties": {
          "id": { "type": "string", "pattern": "^(IT|EC)-[0-9A-Za-z-]+$" },
          "instrument": { "type": "string", "enum": ["IT-RULES", "ECOM-RULES"] },
          "clause": { "type": "string", "pattern": "^Rule [0-9]+[A-Z]?(\\([0-9A-Za-z]+\\))*$", "description": "One reference, written the way findings must cite it" },
          "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["intermediary", "smi", "ssmi", "sgi", "ecom", "ecom-marketplace", "ecom-inventory"] }, "description": "The rule applies if the classification has any of these tags" },
          "obligation": { "type": "string", "minLength": 1 },
          "deadline": { "type": "string", "minLength": 1, "description": "The clock, e.g. '36 hours from the complaint', or 'Always'" },
          "evidence_hints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "default_severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "verified": { "type": "boolean", "description": "true only once the clause number and the deadline were read in the gazette text" },
          "source_url": { "type": "string", "pattern": "^https://" },
          "note": { "type": "string", "description": "What was not confirmed, or how an earlier amendment bears on the clause" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
